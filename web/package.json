{
  "name": "birdie",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Birdie — answer birdsong with pieces, collect birds, hear your backyard chorus",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
